{
  "name": "kolam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A new sikku kolam every day. Save it, print it, draw it.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prerender": "tsx scripts/prerender.ts"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
